{
  "name": "copytextlocation",
  "displayName": "Copy Text and Location",
  "description": "Copy a selection's file path and exact line and UTF-16 column range, with or without the selected text.",
  "version": "0.1.0",
  "publisher": "kvu787",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kvu787/CopyTextLocation_VisualStudioCode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./Source/Extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      {
        "command": "copyTextLocation.copyTextAndLocation",
        "title": "Copy text and location",
        "enablement": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote)"
      },
      {
        "command": "copyTextLocation.copyLocation",
        "title": "Copy location",
        "enablement": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copyTextLocation.copyTextAndLocation",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_cutcopypaste@3"
        },
        {
          "command": "copyTextLocation.copyLocation",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_cutcopypaste@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "node Scripts/Build.js",
    "test": "node --test Tests/Extension.test.js",
    "vscode:prepublish": "node Scripts/Build.js"
  }
}
